<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CrashBytes.Enums</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>CrashBytes.Enums</PackageId>
    <Authors>CrashBytes</Authors>
    <Company>CrashBytes</Company>
    <Copyright>Copyright (c) 2026 CrashBytes</Copyright>
    <Description>Cached runtime enum utilities for .NET — GetDescription, GetDisplayName, GetEnumMemberValue, HasFlagFast (non-boxing), GetFlags, TryParse. Per-type reflection cache with ConcurrentDictionary; no per-call allocations after first resolution.</Description>
    <PackageTags>enum;extensions;description;display-name;flags;has-flag;cached;utility</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CrashBytes/CrashBytes.Enums</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CrashBytes/CrashBytes.Enums</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Symbol packages for source debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
